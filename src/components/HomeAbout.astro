---
import HomeAboutApp from './react/HomeAbout';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
---

<HomeAboutApp client:visible locale={locale} />

<style is:global>
	.home-about {
		padding-block: clamp(2.5rem, 5vw, 3.75rem) clamp(1.35rem, 3vw, 2rem);
		color: var(--ink-muted);
		font-size: 0.9375rem;
		line-height: 1.6;
	}

	.home-about__head {
		margin-bottom: 1.35rem;
		padding-bottom: 1.2rem;
		border-bottom: 1px solid var(--line-soft);
	}

	.home-about__eyebrow {
		margin: 0 0 0.45rem;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--magenta-soft);
	}

	.home-about__head h2 {
		margin: 0;
		max-width: 22ch;
		font-family: var(--font-display);
		font-size: clamp(1.55rem, 3.2vw, 2.15rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.15;
		color: var(--magenta);
		text-shadow: 0 0 24px color-mix(in srgb, var(--magenta) 28%, transparent);
		text-wrap: balance;
	}

	.home-about__lede {
		margin: 0.65rem 0 0;
		max-width: 40rem;
		font-size: 1rem;
		line-height: 1.5;
		color: var(--ink);
	}

	.home-about__panel {
		display: grid;
		gap: 1rem;
		padding: clamp(1.15rem, 2.4vw, 1.5rem);
		border: 1px solid var(--line);
		border-radius: var(--radius-lg, 1rem);
		background:
			linear-gradient(90deg, color-mix(in srgb, var(--magenta) 55%, transparent), transparent 4px),
			radial-gradient(ellipse 80% 90% at 0% 0%, color-mix(in srgb, var(--magenta) 12%, transparent), transparent 55%),
			var(--bg-panel);
	}

	.home-about__panel p {
		margin: 0;
		max-width: 62rem;
		color: var(--ink-muted);
	}

	.home-about__facts {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.home-about__facts li {
		display: inline-flex;
		align-items: center;
		min-height: 2rem;
		padding: 0.35rem 0.7rem;
		border: 1px solid color-mix(in srgb, var(--magenta) 28%, var(--line));
		border-radius: 999px;
		background: color-mix(in srgb, var(--magenta) 10%, transparent);
		color: var(--magenta-soft);
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.01em;
	}

	.home-about__links {
		margin-top: 1.35rem;
	}

	.home-about__links-label {
		margin: 0 0 0.7rem;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	.home-about__links ul {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.65rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.home-about__links a {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 0.45rem;
		min-height: 6.25rem;
		padding: 0.95rem 1rem 1.05rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		background: var(--bg-panel);
		color: var(--ink);
		text-decoration: none;
		transition:
			border-color 0.15s ease,
			background 0.15s ease;
	}

	.home-about__links a:hover {
		border-color: color-mix(in srgb, var(--magenta) 32%, var(--line));
		background: color-mix(in srgb, var(--magenta) 8%, var(--bg-panel));
	}

	.home-about__link-title {
		font-family: var(--font-display);
		font-size: 0.95rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		line-height: 1.25;
		padding-right: 1.1rem;
	}

	.home-about__link-hint {
		font-size: 0.78rem;
		line-height: 1.4;
		color: var(--ink-faint);
		font-weight: 500;
	}

	.home-about__link-arrow {
		position: absolute;
		top: 1.05rem;
		right: 1rem;
		width: 0.38rem;
		height: 0.38rem;
		border-right: 1.6px solid var(--magenta-soft);
		border-bottom: 1.6px solid var(--magenta-soft);
		transform: rotate(-45deg);
		opacity: 0.7;
	}

	@media (max-width: 900px) {
		.home-about__links ul {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.home-about__head h2 {
			max-width: none;
		}
	}

	@media (max-width: 480px) {
		.home-about__links ul {
			grid-template-columns: 1fr;
		}

		.home-about__links a {
			min-height: var(--touch-min, 2.75rem);
		}

		.home-about__facts li {
			min-height: var(--touch-min, 2.75rem);
		}
	}
</style>
